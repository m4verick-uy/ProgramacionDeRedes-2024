<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- IP y puerto donde escucha el servidor. -->
    <add key="ServidorIp" value="127.0.0.1" />
    <add key="ServidorPuerto" value="20000" />

    <!-- Backlog: tamaño de la cola de conexiones en espera (Socket.Listen). -->
    <add key="Backlog" value="100" />

    <!-- CR5: segundos que una reserva queda Pendiente antes de resolverse. -->
    <add key="SegundosProcesarReserva" value="5" />

    <!-- Carpeta donde el servidor guarda las imágenes de los modelos. -->
    <add key="CarpetaImagenes" value="imagenes" />
  </appSettings>
</configuration>
